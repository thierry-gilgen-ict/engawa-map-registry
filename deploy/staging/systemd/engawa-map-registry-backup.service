[Unit]
Description=Engawa Map registry staging PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/engawa-map-registry/deploy/staging
ExecStart=/opt/engawa-map-registry/deploy/staging/backup.sh
User=root
Group=root
UMask=0077

[Install]
WantedBy=multi-user.target
