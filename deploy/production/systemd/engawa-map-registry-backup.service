[Unit]
Description=Engawa Map registry production PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/engawa-map-registry/deploy/production
ExecStart=/opt/engawa-map-registry/deploy/production/backup.sh
User=root
Group=root
UMask=0077

[Install]
WantedBy=multi-user.target
